{
  "env": {
    "LC_ALL": "C"
  },
  "permissions": {
    "allow": [
      "mcp__playwright",

      "Bash(git status:*)",
      "Bash(git log:*)",
      "Bash(git diff:*)",
      "Bash(git show:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git stash:*)",
      "Bash(git branch:*)",
      "Bash(git fetch:*)",
      "Bash(git worktree:*)",
      "Bash(rtk git status:*)",
      "Bash(rtk git log:*)",
      "Bash(rtk git diff:*)",
      "Bash(rtk git show:*)",
      "Bash(rtk git add:*)",
      "Bash(rtk git commit:*)",
      "Bash(rtk git stash:*)",
      "Bash(rtk git branch:*)",
      "Bash(rtk git fetch:*)",
      "Bash(rtk git worktree:*)",
      "PowerShell(git status:*)",
      "PowerShell(git log:*)",
      "PowerShell(git diff:*)",
      "PowerShell(git show:*)",
      "PowerShell(git add:*)",
      "PowerShell(git commit:*)",
      "PowerShell(git stash:*)",
      "PowerShell(git branch:*)",
      "PowerShell(git fetch:*)",
      "PowerShell(git worktree:*)",
      "PowerShell(rtk git status:*)",
      "PowerShell(rtk git log:*)",
      "PowerShell(rtk git diff:*)",
      "PowerShell(rtk git show:*)",
      "PowerShell(rtk git add:*)",
      "PowerShell(rtk git commit:*)",
      "PowerShell(rtk git stash:*)",
      "PowerShell(rtk git branch:*)",
      "PowerShell(rtk git fetch:*)",
      "PowerShell(rtk git worktree:*)",

      "Bash(npx playwright:*)",
      "Bash(rtk npx playwright:*)",
      "Bash(node_modules/.bin/playwright:*)",
      "PowerShell(npx playwright:*)",
      "PowerShell(rtk npx playwright:*)",

      "Bash(npm:*)",
      "Bash(npx:*)",
      "Bash(rtk npm:*)",
      "Bash(rtk npx:*)",
      "PowerShell(npm:*)",
      "PowerShell(npx:*)",
      "PowerShell(rtk npm:*)",
      "PowerShell(rtk npx:*)",

      "Bash(dotnet:*)",
      "Bash(rtk dotnet:*)",
      "PowerShell(dotnet:*)",
      "PowerShell(rtk dotnet:*)",

      "Bash(cat:*)",
      "Bash(ls:*)",
      "Bash(echo:*)",
      "Bash(head:*)",
      "Bash(tail:*)",
      "Bash(wc:*)",
      "Bash(find:*)",
      "Bash(grep:*)",
      "Bash(rtk ls:*)",
      "Bash(rtk read:*)",
      "Bash(rtk grep:*)",
      "Bash(rtk find:*)",

      "Read(//c//**)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "bash scripts/hooks/post-edit.sh"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash scripts/hooks/stop-gate.sh"
          }
        ]
      }
    ]
  }
}
