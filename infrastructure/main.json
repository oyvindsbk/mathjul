            "containerAppName": {
              "type": "string",
              "metadata": {
                "description": "The name of the frontend Container App"
              }
            },
            "location": {
              "type": "string",
              "metadata": {
                "description": "The location for the Container App"
              }
            },
            "backendApiUrl": {
              "type": "string",
              "metadata": {
                "description": "Backend API URL passed as env var and baked in via Docker build-arg"
              }
            },
            "googleClientId": {
              "type": "string",
              "defaultValue": "",
              "metadata": {
                "description": "Google OAuth Client ID (public)"
              }
            },
            "googleClientSecret": {
              "type": "securestring",
              "defaultValue": "",
              "metadata": {
                "description": "Google OAuth Client Secret"
              }
            },
            "appUrl": {
              "type": "string",
              "defaultValue": "",
              "metadata": {
                "description": "Public URL of this frontend app, used to construct OAuth redirect URI"
              }
            },
            "customDomainName": {
              "type": "string",
              "defaultValue": "",
              "metadata": {
                "description": "Custom domain bound to the ingress, e.g. mathjul.kheradmandi.no. Leave empty to serve only on the generated fqdn."
              }
            },
            "customDomainCertificateName": {
              "type": "string",
              "defaultValue": "",
              "metadata": {
                "description": "Name of the managed certificate for customDomainName, as shown in the Container Apps environment. Leave empty to bind the domain without a certificate (validation only)."
              }
            },
            "containerImage": {
              "type": "string",
              "defaultValue": "mcr.microsoft.com/dotnet/samples:aspnetapp",
              "metadata": {
                "description": "Container image to deploy"
              }
            },
            "tags": {
              "type": "object",
              "defaultValue": {},
              "metadata": {
                "description": "Tags to apply to resources"
              }
            }
          },
          "resources": [
            {
              "type": "Microsoft.OperationalInsights/workspaces",
              "apiVersion": "2022-10-01",
              "name": "[format('{0}-logs', parameters('containerAppName'))]",
              "location": "[parameters('location')]",
              "tags": "[parameters('tags')]",
              "properties": {
                "sku": {
                  "name": "PerGB2018"
                },
                "retentionInDays": 30
              }
            },
            {
              "type": "Microsoft.App/managedEnvironments",
              "apiVersion": "2023-05-01",
              "name": "[format('{0}-env', parameters('containerAppName'))]",
              "location": "[parameters('location')]",
              "tags": "[parameters('tags')]",
              "properties": {
                "appLogsConfiguration": {
                  "destination": "log-analytics",
                  "logAnalyticsConfiguration": {
                    "customerId": "[reference(resourceId('Microsoft.OperationalInsights/workspaces', format('{0}-logs', parameters('containerAppName'))), '2022-10-01').customerId]",
                    "sharedKey": "[listKeys(resourceId('Microsoft.OperationalInsights/workspaces', format('{0}-logs', parameters('containerAppName'))), '2022-10-01').primarySharedKey]"
                  }
                }
              },
              "dependsOn": [
                "[resourceId('Microsoft.OperationalInsights/workspaces', format('{0}-logs', parameters('containerAppName')))]"
              ]
            },
            {
              "type": "Microsoft.App/containerApps",
              "apiVersion": "2023-05-01",
              "name": "[parameters('containerAppName')]",
              "location": "[parameters('location')]",
              "tags": "[parameters('tags')]",
              "properties": {
                "managedEnvironmentId": "[resourceId('Microsoft.App/managedEnvironments', format('{0}-env', parameters('containerAppName')))]",
                "configuration": {
                  "ingress": {
                    "external": true,
                    "targetPort": 3000,
                    "transport": "auto",
                    "allowInsecure": false,
                    "customDomains": "[if(empty(parameters('customDomainName')), createArray(), createArray(createObject('name', parameters('customDomainName'), 'bindingType', if(empty(parameters('customDomainCertificateName')), 'Disabled', 'SniEnabled'), 'certificateId', if(empty(parameters('customDomainCertificateName')), null(), format('{0}/managedCertificates/{1}', resourceId('Microsoft.App/managedEnvironments', format('{0}-env', parameters('containerAppName'))), parameters('customDomainCertificateName'))))))]"
                  },
                  "secrets": "[if(not(empty(parameters('googleClientSecret'))), createArray(createObject('name', 'google-client-secret', 'value', parameters('googleClientSecret'))), createArray())]"
                },
                "template": {
                  "containers": [
                    {
                      "name": "recipe-frontend",
                      "image": "[parameters('containerImage')]",
                      "resources": {
                        "cpu": "[json('0.25')]",
                        "memory": "0.5Gi"
                      },
                      "env": "[flatten(createArray(createArray(createObject('name', 'NODE_ENV', 'value', 'production'), createObject('name', 'PORT', 'value', '3000'), createObject('name', 'HOSTNAME', 'value', '0.0.0.0'), createObject('name', 'NEXT_PUBLIC_API_BASE_URL', 'value', parameters('backendApiUrl')), createObject('name', 'GOOGLE_CLIENT_ID', 'value', parameters('googleClientId'))), if(not(empty(parameters('googleClientSecret'))), createArray(createObject('name', 'GOOGLE_CLIENT_SECRET', 'secretRef', 'google-client-secret')), createArray()), if(not(empty(parameters('appUrl'))), createArray(createObject('name', 'NEXTAUTH_URL', 'value', parameters('appUrl'))), createArray())))]"
                    }
                  ],
                  "scale": {
                    "minReplicas": 0,
                    "maxReplicas": 2,
                    "rules": [
                      {
                        "name": "http-scaling",
                        "http": {
                          "metadata": {
                            "concurrentRequests": "10"
                          }
                        }
                      }
                    ]
                  }
                }
              },
              "dependsOn": [
                "[resourceId('Microsoft.App/managedEnvironments', format('{0}-env', parameters('containerAppName')))]"
              ]
            }
          ],
          "outputs": {
            "containerAppUrl": {
              "type": "string",
              "value": "[format('https://{0}', reference(resourceId('Microsoft.App/containerApps', parameters('containerAppName')), '2023-05-01').configuration.ingress.fqdn)]"
            },
            "containerAppName": {
              "type": "string",
              "value": "[parameters('containerAppName')]"
            }
          }
        }
      },
      "dependsOn": [
        "[resourceId('Microsoft.Resources/deployments', 'containerAppDeployment')]"
      ]
    }
  ],
  "outputs": {
    "keyVaultName": {
      "type": "string",
      "value": "[reference(resourceId('Microsoft.Resources/deployments', 'keyVaultDeployment'), '2025-04-01').outputs.keyVaultName.value]"
    },
    "sqlServerFqdn": {
      "type": "string",
      "value": "[reference(resourceId('Microsoft.Resources/deployments', 'sqlServerDeployment'), '2025-04-01').outputs.sqlServerFqdn.value]"
    },
    "containerAppUrl": {
      "type": "string",
      "value": "[reference(resourceId('Microsoft.Resources/deployments', 'containerAppDeployment'), '2025-04-01').outputs.containerAppUrl.value]"
    },
    "frontendUrl": {
      "type": "string",
      "value": "[reference(resourceId('Microsoft.Resources/deployments', 'frontendContainerAppDeployment'), '2025-04-01').outputs.containerAppUrl.value]"
    },
    "frontendContainerAppName": {
      "type": "string",
      "value": "[reference(resourceId('Microsoft.Resources/deployments', 'frontendContainerAppDeployment'), '2025-04-01').outputs.containerAppName.value]"
    }
  }
}